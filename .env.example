NODE_ENV=development
FLOW_HOST=127.0.0.1
FLOW_PORT=4010
FLOW_WEB_ORIGIN=http://localhost:5173
FLOW_DATABASE_URL=postgres://flow:flow@localhost:5432/flow
FLOW_AUTH_MODE=development
FLOW_SESSION_SECRET=replace-with-at-least-32-random-characters
FLOW_SESSION_TTL_HOURS=168
FLOW_LOG_LEVEL=info

# OpenAI Responses API. Chat falls back to a deterministic local response when omitted.
OPENAI_API_KEY=
FLOW_OPENAI_MODEL=gpt-5.6-sol
FLOW_OPENAI_REASONING_EFFORT=medium
FLOW_ENABLE_WEB_DEAL_RESEARCH=true

# Real web discovery and supported browser handoffs.
FLOW_WEBCMD_PATH=webcmd
FLOW_WEBCMD_PROFILE=flow
FLOW_WEBCMD_TIMEOUT_MS=45000
FLOW_ENABLE_WEBCMD=true

# Optional krushiraj/bms-bot bridge. See docs/providers/bms-bot.md.
FLOW_BMS_BOT_PATH=
FLOW_BMS_BOT_TIMEOUT_MS=180000
FLOW_BMS_BOT_HANDOFF_TTL_MS=600000

# Optional UiPath Orchestrator bridge. See docs/providers/uipath.md.
FLOW_UIPATH_BASE_URL=
FLOW_UIPATH_ACCESS_TOKEN=
FLOW_UIPATH_FOLDER_ID=
FLOW_UIPATH_RELEASE_KEY=

# Worker settings.
FLOW_WORKER_ID=
FLOW_WORKER_POLL_MS=2000
FLOW_WORKER_CONCURRENCY=4
FLOW_JOB_LEASE_SECONDS=120
FLOW_MAX_COUPON_ATTEMPTS=8
